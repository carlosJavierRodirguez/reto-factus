# Variables de entorno — API Factus (Halltec)
# Copia este archivo como `.env` y completa los valores.
# Las credenciales (CLIENT_ID y CLIENT_SECRET) las provee Halltec, la empresa
# dueña de la API Factus; no se generan desde este proyecto.

# URL base de la API Factus.
# Sandbox (pruebas): https://api-sandbox.factus.com.co
# Producción: la URL de producción la entrega Halltec.
URL_API=https://api-sandbox.factus.com.co

# Identificador de cliente (Client ID) para autenticación OAuth contra la API Factus.
# Provisto por Halltec.
CLIENT_ID=

# Secreto de cliente (Client Secret) para autenticación OAuth contra la API Factus.
# Provisto por Halltec. Nunca commitear el valor real (solo vive en `.env`, que está en .gitignore).
CLIENT_SECRET=

